FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app

# Streamlit + HTTP client only — no ML deps needed for the dashboard
RUN pip install --no-cache-dir "streamlit>=1.38" "requests>=2.31"

# Copy just the dashboard
COPY apps/dashboard/ ./apps/dashboard/

EXPOSE 8501

# API_URL points at the api service via the compose network
ENV API_URL=http://api:8000

CMD ["streamlit", "run", "apps/dashboard/app.py", \
     "--server.address=0.0.0.0", "--server.port=8501", \
     "--server.headless=true"]