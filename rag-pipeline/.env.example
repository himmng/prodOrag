## ollama 
OLLAMA_API_KEY="none"
OLLAMA_HOST="localhost"
OLLAMA_PORT="11434"
OLLAMA_MODEL="gemma-4-e4b:latest"

## embedding model
EMBEDDING_MODEL="embeddinggemma:latest"

## generation
LLM_TEMPERATURE="0.0"
LLM_NUM_CTX="8192"

## retrieval
CHUNK_SIZE="800"
CHUNK_OVERLAP="120"
TOP_K="5"

## paths
CHROMA_PERSIST_DIR="./chroma_db"
DATA_RAW_DIR="./data/raw"
DATA_PROCESSED_DIR="./data/processed"


# Copy this file to .env and fill in values for your active provider.
# Only set the block matching MODEL_PROVIDER; leave the others commented.

MODEL_PROVIDER=ollama          # ollama | azure | aws | gcp | openai

# ── Ollama (local dev) ──────────────────────────────────────────────────

# ── Azure OpenAI ────────────────────────────────────────────────────────
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── AWS Bedrock ─────────────────────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# AWS credentials come from the standard chain: ~/.aws/credentials, IAM role, or AWS_ACCESS_KEY_ID/SECRET

# ── GCP Vertex AI ───────────────────────────────────────────────────────
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# GCP_VERTEX_MODEL=gemini-2.0-pro
# GCP_VERTEX_EMBEDDING_MODEL=text-embedding-005
# GCP auth comes from ADC: GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# ── OpenAI (direct) ─────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
LOG_LEVEL=INFO