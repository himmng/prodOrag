
#local api
ANONYMIZED_TELEMETRY=FALSE
API_KEYS=dev-key-123,another-key-456

# dashboard (apps/dashboard/app.py) — first key from API_KEYS above
API_URL=http://localhost:8000
DASHBOARD_API_KEY=dev-key-123

## generation
LLM_TEMPERATURE="0.0"
LLM_NUM_CTX="8192"

## retrieval
CHUNK_SIZE="800"
CHUNK_OVERLAP="120"
TOP_K="5"
RERANKER_MODEL="BAAI/bge-reranker-base"

# providers
LLM_PROVIDER="azure"
EMBEDDING_PROVIDER="ollama"


# azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-5.4-nano"

## ollama 
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY="none"
OLLAMA_HOST="localhost"
OLLAMA_PORT="11434"
OLLAMA_MODEL="deepseek-r1:1.5b"
#"gemma-4-e4b:latest"
OLLAMA_EMBEDDING_MODEL="embeddinggemma:latest"


## eval set
EVAL_SET_FILE=eval_set_v3.json

# act boost
PREFERRED_ACT=""
ACT_TIE_DELTA=0.00

# Generator — the model whose answers you're evaluating (your production answerer)
RAGAS_GENERATOR_PROVIDER=azure          # reuses your provider system

# Judges — one or two. Each names a provider the judge runs on.
RAGAS_JUDGE1_PROVIDER=azure             # e.g. gpt-nano judging itself
RAGAS_JUDGE2_PROVIDER=                  # e.g. a stronger deployed model; blank = skip judge 2


# Generator
RAGAS_GEN_PROVIDER=azure
RAGAS_GEN_DEPLOYMENT=gpt-nano

# Judge 1
RAGAS_JUDGE1_PROVIDER=azure
RAGAS_JUDGE1_DEPLOYMENT=gpt-nano        # same model (self-judge baseline)

# Judge 2 (blank to skip)
RAGAS_JUDGE2_PROVIDER=azure
RAGAS_JUDGE2_DEPLOYMENT=<your-stronger-model>