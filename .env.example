
#local api
ANONYMIZED_TELEMETRY=FALSE
API_KEYS=dev-key-123,another-key-456

## generation
#LLM_TEMPERATURE="0.0"
LLM_NUM_CTX="8192"

## retrieval
CHUNK_SIZE="800"
CHUNK_OVERLAP="120"
TOP_K="5"

# providers
LLM_PROVIDER="azure"
EMBEDDING_PROVIDER="ollama"

# azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-5.6-luna"
AZURE_OPENAI_DEPLOYMENT_TEMPERATURE="1.0"

## ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY="none"
OLLAMA_MODEL="deepseek-r1:1.5b"
OLLAMA_MODEL_TEMPERATURE="1.0"
#"gemma-4-e4b:latest"
OLLAMA_EMBEDDING_MODEL="embeddinggemma:latest"
OLLAMA_EMBEDDING_TEMPERATURE="1.0"


## eval set
EVAL_SET_FILE=eval_set_v5.json

# RAGAS Generator & Judges
RAGAS_GEN_PROVIDER=azure
RAGAS_GEN_DEPLOYMENT="gpt-5.4-nano"
RAGAS_GEN_TEMPERATURE="1.0"
RAGAS_JUDGE_DEPLOYMENTS="gpt-5.6-luna","gpt-5.4-nano",""
RAGAS_JUDGE_TEMPERATURE="1.0"


# act boost
PREFERRED_ACT=""
ACT_TIE_DELTA=0.00

# dashboard
API_URL=http://localhost:8000
DASHBOARD_API_KEY=dev-key-123
